# Campora environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local or real secrets.
#
# The current version of Campora is a frontend-only build with sample data
# and browser (localStorage) persistence, so NO variables are required yet.
# The Supabase variables below are placeholders for the later backend phase
# (database + authentication), and are not used by the current code.

# Supabase (later phase — not yet integrated)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
