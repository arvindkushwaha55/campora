# Campora environment variables.
# Copy this file to ".env.local" for local development and fill in BOTH values
# from your Supabase project: Dashboard -> Settings -> API.
#
# These two values are PUBLIC client credentials — the anon key is designed
# to be used in the browser. Your data is protected by Row Level Security
# (see supabase/schema.sql). NEVER put the service-role key in this file or
# anywhere in the frontend.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
